<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Restores of edits that were made DIRECTLY in the arch of Odoo core views on the Odoo 17 database
         (ir_ui_view.arch_updated = True). Those edits lived nowhere in git, and the 17 -> 19 upgrade reset
         every core view to the stock 19 arch, silently dropping them. Each one is re-expressed here as a
         normal inherited view so it survives future upgrades. -->

    <!-- stock.view_stock_quant_tree_simple (17 DB view 653): the quant list opened by the pick_from widget
         when choosing pallets on a withdrawal. The Special Holding restriction
         (special_holding_restrict.xml) hangs on these columns, so this file must load before it. -->
    <record id="view_stock_quant_tree_simple_vifel" model="ir.ui.view">
        <field name="name">stock.quant.list.vifel</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <!-- 17 DB edit dropped export_xlsx="0": the list can be exported -->
            <xpath expr="//list" position="attributes">
                <attribute name="export_xlsx">1</attribute>
            </xpath>
            <field name="package_id" position="before">
                <field name="x_studio_stock_code"/>
                <field name="x_studio_pallet_series_id"/>
                <field name="x_studio_return_count"/>
            </field>
            <field name="owner_id" position="after">
                <!-- 17 added a second, ungrouped Owner so users outside group_tracking_owner see it too;
                     gated with "!" here so group members do not get the column twice -->
                <field name="owner_id" groups="!stock.group_tracking_owner"/>
                <field name="x_studio_production_date"/>
                <field name="x_studio_expiration_date"/>
                <field name="x_studio_special_holding"/>
                <field name="x_studio_sh_reason"/>
                <field name="x_studio_container_number"/>
            </field>
        </field>
    </record>

    <!-- stock.view_location_tree2: locations cannot be duplicated -->
    <record id="view_location_tree2_vifel" model="ir.ui.view">
        <field name="name">stock.location.list.vifel</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="duplicate">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- stock.view_stock_quant_tree_editable: On Hand bold; Reserved bold and red when anything is reserved.
         (17 also limited the "Inventory Adjustment" pencil to stock managers - Odoo 19 removed that button.) -->
    <record id="view_stock_quant_tree_editable_vifel" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.vifel</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <field name="inventory_quantity_auto_apply" position="attributes">
                <attribute name="class">fw-bolder</attribute>
            </field>
            <field name="reserved_quantity" position="attributes">
                <attribute name="class">fw-bolder</attribute>
                <attribute name="decoration-danger">reserved_quantity &gt; 0</attribute>
            </field>
        </field>
    </record>

    <!-- stock.view_stock_quant_tree_inventory_editable (Physical Inventory): "Clear" for every user, Created On
         shown, and Location / Pallet # editable on existing lines (Pallet # with no domain) -->
    <record id="view_stock_quant_tree_inventory_editable_vifel" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.vifel</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reset']" position="attributes">
                <attribute name="groups"></attribute>
            </xpath>
            <field name="create_date" position="attributes">
                <attribute name="column_invisible">False</attribute>
            </field>
            <field name="location_id" position="attributes">
                <attribute name="readonly">False</attribute>
            </field>
            <field name="package_id" position="attributes">
                <attribute name="readonly">False</attribute>
                <attribute name="domain">[]</attribute>
            </field>
        </field>
    </record>

    <!-- Package (pallet) list, stock.view_quant_package_tree on 17 = stock.stock_package_view_list on 19:
         oldest first -->
    <record id="stock_package_view_list_vifel" model="ir.ui.view">
        <field name="name">stock.package.list.vifel</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">id</attribute>
            </xpath>
        </field>
    </record>

    <!-- stock.quant_search_view: Pallet # is the FIRST search field (typing searches pallets first), and the
         Pallet # group-by sits before Owner -->
    <record id="quant_search_view_vifel" model="ir.ui.view">
        <field name="name">stock.quant.search.vifel</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[1]" position="before">
                <xpath expr="//field[@name='package_id']" position="move"/>
            </xpath>
            <xpath expr="//filter[@name='owner']" position="before">
                <xpath expr="//filter[@name='package']" position="move"/>
            </xpath>
        </field>
    </record>

    <!-- stock.view_picking_form: Pallet Breakdown on hotkey D (its label is set in view_stock_picking_form_custom),
         wider Product column, and Lot/Serial tags only for serial-tracked products, visible in draft too.
         (17's Operation Type domain and Cancel-without-confirm are moot on 19: later views make Operation Type
         read-only and hide Cancel.) -->
    <record id="view_picking_form_vifel" model="ir.ui.view">
        <field name="name">stock.picking.form.vifel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_detailed_operations']" position="attributes">
                <attribute name="data-hotkey">d</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="attributes">
                <attribute name="width">200px</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='lot_ids']" position="attributes">
                <attribute name="column_invisible">False</attribute>
                <attribute name="invisible">not show_details_visible or has_tracking != 'serial'</attribute>
            </xpath>
        </field>
    </record>

    <!-- stock.view_move_line_form: show the adjustment reason -->
    <record id="view_move_line_form_vifel" model="ir.ui.view">
        <field name="name">stock.move.line.form.vifel</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_uid']" position="after">
                <field name="x_studio_reason_for_adjustment" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- stock.view_move_line_tree (Moves History): 17 dropped duplicate="0" -->
    <record id="view_move_line_tree_vifel" model="ir.ui.view">
        <field name="name">stock.move.line.list.vifel</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="duplicate">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- stock.stock_move_line_view_search: Source / Destination Pallet # searchable right after Product, and an
         "Adjustment" filter -->
    <record id="stock_move_line_view_search_vifel" model="ir.ui.view">
        <field name="name">stock.move.line.search.vifel</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <xpath expr="//field[@name='result_package_id']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <xpath expr="//field[@name='package_id']" position="move"/>
            </xpath>
            <field name="package_id" position="attributes">
                <attribute name="string">Source Pallet #</attribute>
            </field>
            <field name="result_package_id" position="attributes">
                <attribute name="string">Destination Pallet #</attribute>
            </field>
            <filter name="internal" position="after">
                <filter string="Adjustment" name="adjustment" domain="[('is_quant_detail_adjusted', '!=', False)]"/>
            </filter>
        </field>
    </record>

    <!-- stock.view_picking_internal_search: group by Customer and Responsible User -->
    <record id="view_picking_internal_search_vifel" model="ir.ui.view">
        <field name="name">stock.picking.search.vifel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <filter name="picking_type" position="after">
                <filter string="Customer" name="vifel_groupby_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                <filter string="Responsible User" name="vifel_groupby_user" domain="[]" context="{'group_by': 'user_id'}"/>
            </filter>
        </field>
    </record>

    <!-- stock.vpicktree (Transfers list): no From / To columns, bold wider Reference, wider Responsible -->
    <record id="vpicktree_vifel" model="ir.ui.view">
        <field name="name">stock.picking.list.vifel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="attributes">
                <attribute name="class">fw-bolder</attribute>
                <attribute name="width">150px</attribute>
            </xpath>
            <xpath expr="//list/field[@name='location_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//list/field[@name='location_dest_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//list/field[@name='user_id']" position="attributes">
                <attribute name="width">200px</attribute>
            </xpath>
        </field>
    </record>

    <!-- stock.view_stock_move_line_detailed_operation_tree (Pallet Breakdown base): Product always read-only,
         the pallet picker read-only on withdrawals, destination labelled "Location" and not openable, Unit hidden
         by default. The other 17 edits here (lot columns, quantity label/lock, Pallet #) are superseded by
         view_stock_move_line_detailed_operation_tree_inherit. -->
    <record id="view_stock_move_line_detailed_operation_tree_vifel" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.vifel</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='product_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//list/field[@name='quant_id']" position="attributes">
                <attribute name="readonly">picking_code == 'outgoing'</attribute>
            </xpath>
            <xpath expr="//list/field[@name='location_dest_id'][last()]" position="attributes">
                <attribute name="string">Location</attribute>
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
            <xpath expr="//list/field[@name='product_uom_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- stock.stock_report_delivery_aggregated_move_lines (Delivery Slip): description printed without the
         text widget -->
    <template id="stock_report_delivery_aggregated_move_lines_vifel"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//span[@t-esc=&quot;aggregated_lines[line]['description']&quot;]" position="attributes">
            <attribute name="t-options"></attribute>
        </xpath>
    </template>
</odoo>
