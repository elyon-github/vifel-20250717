<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Attach the VIFEL quant list controller to the default editable quant
        tree. The controller renders the "Generate Report" button only when
        the action passes show_pkr_report, so every other stock.quant screen
        behaves exactly as before.
    -->
    <record id="view_stock_quant_tree_editable_vifel_report" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.vifel.report</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="js_class">vifel_quant_report_list</attribute>
            </xpath>
        </field>
    </record>

    <!--
        Turn the button on for the Normal / Blast Freeze Inventory Overview
        actions. These are Studio-owned records, so they are patched by name
        instead of by XML id (idempotent, runs on every module update, and
        does nothing if the actions were renamed or are absent).
    -->
    <function model="ir.actions.act_window" name="vifel_enable_quant_report_button"/>

</odoo>
