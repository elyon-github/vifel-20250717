<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Printed By names (19.0.0.4.38), same rights as Noted By: everyone
         reads the list (the dropdown), only 'Deviation Report: Noted By'
         members (Cyril's account) change it in the Configuration tab. -->
    <record id="access_vifel_printed_by_name_user" model="ir.model.access">
        <field name="name">vifel.printed.by.name user (read)</field>
        <field name="model_id" ref="model_vifel_printed_by_name"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_vifel_printed_by_name_manager" model="ir.model.access">
        <field name="name">vifel.printed.by.name noted-by (manage)</field>
        <field name="model_id" ref="model_vifel_printed_by_name"/>
        <field name="group_id" ref="group_deviation_noted_by"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Configuration tab: Printed By list next to the Noted By list. -->
    <record id="view_picking_form_printed_by_config" model="ir.ui.view">
        <field name="name">stock.picking.form.printed.by.config</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="multiple_relocation.view_picking_form_noted_by"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='vifel_configuration']" position="inside">
                <field name="vifel_printed_by_name_ids" nolabel="1" class="mt-4">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="name" string="Printed By Names"/>
                    </list>
                </field>
                <div class="text-muted">
                    Names the documentation staff can choose as Printed By (next to NCR-Remarks).
                    Removing a name here hides it from the list; transfers that already use it keep it.
                </div>
            </xpath>
        </field>
    </record>

    <!-- The dropdown itself is placed in the Studio Transfer form, next to
         the typed Printed By it replaces, by migration 19.0.0.4.38 (like
         19.0.0.4.28 placed the text field), so a missing anchor can never
         break the whole form. -->
</odoo>
