<odoo>
    <!-- Tree View for Pallet Relocation History -->
    <record id="view_stock_move_line_relocation_history_tree" model="ir.ui.view">
        <field name="name">stock.move.line.relocation.history.tree</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <tree string="Pallet Relocation History">
                <field name="company_id" column_invisible="1"/>
                <field name="product_uom_category_id" column_invisible="1"/>
                <field name="date"/>
                <field name="reference"/>
                <field name="x_studio_relocation_done"/>
                <field name="x_relocate_batch"/>
                <field name="owner_id"/>
                <field name="product_id"/>
                <field name="x_studio_pallet_series_id"/>
                <field name="package_id" string="From Pallet #"/>
                <field name="result_package_id" string="To Pallet #"/>
                <field name="x_studio_container_number"/>
                <field name="x_studio_production_date" optional="hide"/>
                <field name="x_studio_expiration_date" optional="hide"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="x_studio_2nd_uom"/>
                <field name="x_studio_quantity_uom"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
                <field name="state" widget="badge" optional="show"
                       decoration-danger="state == 'cancel'"
                       decoration-info="state == 'assigned'"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state not in ('draft', 'cancel', 'done', 'assigned')"/>
            </tree>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_stock_move_line_relocation_history" model="ir.actions.act_window">
        <field name="name">Pallet Relocation History</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">tree</field>
        <field name="views" eval="[(ref('view_stock_move_line_relocation_history_tree'), 'tree')]"/>
        <field name="domain">[('x_relocate_batch', '!=', False)]</field>
        <field name="target">current</field>
    </record>

    <!-- Menu Item under Inventory > Reporting -->
    <menuitem
        id="menu_stock_move_line_relocation_history"
        name="Pallet Relocation History"
        parent="stock.menu_warehouse_report"
        action="action_stock_move_line_relocation_history"
        sequence="8"
    />

    <!-- Tree View for Pallet Detail Adjustment History -->
    <record id="view_stock_move_line_adjustment_history_tree" model="ir.ui.view">
        <field name="name">stock.move.line.adjustment.history.tree</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <tree string="Pallet Detail Adjustment History">
                <field name="company_id" column_invisible="1"/>
                <field name="product_uom_category_id" column_invisible="1"/>
                <field name="date"/>
                <field name="x_studio_relocation_done"/>
                <field name="x_relocate_batch"/>
                <field name="reference"/>
                <field name="x_studio_reason_for_adjustment"/>
                <field name="owner_id"/>
                <field name="product_id"/>
                <field name="x_studio_pallet_series_id"/>
                <field name="package_id" string="From Pallet #"/>
                <field name="result_package_id" string="To Pallet #"/>
                <field name="x_studio_container_number"/>
                <field name="x_studio_production_date" optional="hide"/>
                <field name="x_studio_expiration_date" optional="hide"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="x_studio_2nd_uom"/>
                <field name="x_studio_quantity_uom"/>
                <field name="adjusted_quantity" optional="hide"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
                <field name="state" widget="badge" optional="show"
                       decoration-danger="state == 'cancel'"
                       decoration-info="state == 'assigned'"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state not in ('draft', 'cancel', 'done', 'assigned')"/>
            </tree>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_stock_move_line_adjustment_history" model="ir.actions.act_window">
        <field name="name">Pallet Detail Adjustment History</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">tree</field>
        <field name="views" eval="[(ref('view_stock_move_line_adjustment_history_tree'), 'tree')]"/>
        <field name="domain">[('adjustment_batch_number', '!=', False)]</field>
        <field name="target">current</field>
    </record>

    <!-- Menu Item under Inventory > Reporting -->
    <menuitem
        id="menu_stock_move_line_adjustment_history"
        name="Pallet Detail Adjustment History"
        parent="stock.menu_warehouse_report"
        action="action_stock_move_line_adjustment_history"
        sequence="9"
    />


</odoo>
