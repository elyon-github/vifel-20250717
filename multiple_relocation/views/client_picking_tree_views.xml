<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Picking list used by the Contact transfer buttons: identical to the
        standard VIFEL transfer list, except the leading Responsible column
        is replaced by Documentation Staff — the person who actually owns
        the document in this operation.

        A primary view (not a global extension) so every other transfer
        list keeps Responsible.
    -->
    <record id="view_picking_tree_vifel_client" model="ir.ui.view">
        <field name="name">stock.picking.tree.vifel.client</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <field name="user_id" position="replace">
                <field name="documentation_staff_id" string="Documentation Staff"
                       optional="show" widget="many2one_avatar"
                       readonly="state in ['cancel', 'done']"/>
            </field>
        </field>
    </record>

    <!--
        Transfers reached through a client's smart button belong to that
        client by construction: the list is already filtered to them, so a
        new record must not be able to drift to a different contact.

        The lock is context-gated (vifel_lock_partner), so this is inert on
        every other transfer form. force_save="1" is required — the web
        client drops readonly fields from the payload otherwise.

        Priority 200: Studio already rewrites this field's readonly at
        priority 160, so anything lower is silently overwritten.
    -->
    <record id="view_picking_form_vifel_client_lock" model="ir.ui.view">
        <field name="name">stock.picking.form.vifel.client.lock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id'][@nolabel='1']" position="attributes">
                <attribute name="readonly">state in ['cancel', 'done'] or context.get('vifel_lock_partner')</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
