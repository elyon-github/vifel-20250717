<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Clients hub: the entry point of the Inventory app.

        Encoders start from the client, not from a document type — pick a
        client here and every transfer, stock inquiry and occupied location
        of theirs is one click away through the smart buttons on the form.
        Uses the standard Contacts kanban/list/form, filtered to the
        "Client" tag.
    -->
    <record id="action_vifel_clients" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('category_id.name', '=', 'Client')]</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a client</p>
            <p>
                Clients tagged <b>Client</b> appear here. Open one to see its
                transfers, stocks and occupied locations.
            </p>
        </field>
    </record>

    <!--
        Clients kanban: the standard contact card is CRM-ish and looks
        empty for a warehouse client, so this one shows what encoders
        care about — pallets on hand, locations occupied, transfer
        volume, the latest Pallet Series issued — plus one-click
        shortcuts to the Normal / BF transfer pickers (same actions and
        icons as the form's smart buttons). Only used by the Clients hub;
        the Contacts app keeps the standard card.
    -->
    <record id="view_vifel_clients_kanban" model="ir.ui.view">
        <field name="name">res.partner.kanban.vifel.clients</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="active"/>
                <field name="is_company"/>
                <field name="parent_id"/>
                <field name="avatar_128"/>
                <field name="is_vifel_client"/>
                <field name="vifel_normal_pallet_count"/>
                <field name="vifel_bf_pallet_count"/>
                <field name="vifel_location_count"/>
                <field name="vifel_normal_transfer_count"/>
                <field name="vifel_bf_transfer_count"/>
                <field name="vifel_latest_psi"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <t t-set="avatar_image" t-value="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"/>
                            <t t-if="!record.is_company.raw_value">
                                <div class="o_kanban_image_fill_left d-none d-md-block">
                                    <img t-attf-src="#{avatar_image}" t-att-alt="record.id.value"/>
                                </div>
                                <div class="o_kanban_image d-md-none d-block">
                                    <img t-attf-src="#{avatar_image}" t-att-alt="record.id.value"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="o_kanban_image_fill_left d-none d-md-block o_kanban_image_full">
                                    <img t-attf-src="#{avatar_image}" role="img" t-att-alt="record.id.value"/>
                                </div>
                                <div class="o_kanban_image d-md-none d-block o_kanban_image_full">
                                    <img t-attf-src="#{avatar_image}" role="img" t-att-alt="record.id.value"/>
                                </div>
                            </t>
                            <div class="ribbon ribbon-top-right" invisible="active">
                                <span class="text-bg-danger">Archived</span>
                            </div>
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <field name="display_name"/>
                                </strong>
                                <t t-if="record.is_vifel_client.raw_value">
                                    <div class="d-flex flex-wrap mt-1" style="gap: 3px 6px;">
                                        <span class="badge rounded-pill text-bg-light"
                                              title="Pallets on hand — normal storage">
                                            <i class="fa fa-cubes text-primary me-1"/><t t-esc="record.vifel_normal_pallet_count.raw_value"/> Pallets
                                        </span>
                                        <span class="badge rounded-pill text-bg-light"
                                              title="Blast freeze pallets on hand">
                                            <i class="fa fa-snowflake-o text-info me-1"/><t t-esc="record.vifel_bf_pallet_count.raw_value"/> BF
                                        </span>
                                        <span class="badge rounded-pill text-bg-light"
                                              title="Storage locations currently occupied">
                                            <i class="fa fa-map-marker text-danger me-1"/><t t-esc="record.vifel_location_count.raw_value"/> Locations
                                        </span>
                                        <span class="badge rounded-pill text-bg-light"
                                              t-attf-title="#{record.vifel_normal_transfer_count.raw_value} normal + #{record.vifel_bf_transfer_count.raw_value} blast freeze">
                                            <i class="fa fa-exchange text-success me-1"/><t t-esc="record.vifel_normal_transfer_count.raw_value + record.vifel_bf_transfer_count.raw_value"/> Transfers
                                        </span>
                                    </div>
                                    <div t-if="record.vifel_latest_psi.raw_value"
                                         class="text-muted small mt-1"
                                         title="Most recently issued Pallet Series ID">
                                        <i class="fa fa-barcode me-1"/>Latest PSI:
                                        <strong t-esc="record.vifel_latest_psi.raw_value"/>
                                    </div>
                                    <div class="d-flex mt-2" style="gap: 6px;">
                                        <button type="object" name="action_vifel_normal_transfers"
                                                class="btn btn-sm btn-primary py-0"
                                                title="Normal Transfers — pick Receiving or Withdrawal">
                                            <i class="fa fa-exchange me-1"/>Transfers
                                        </button>
                                        <button type="object" name="action_vifel_bf_transfers"
                                                class="btn btn-sm btn-info py-0"
                                                title="Blast Freeze Transfers — pick BF IN or BF OUT">
                                            <i class="fa fa-snowflake-o me-1"/>BF Transfers
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_vifel_clients_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_vifel_clients_kanban"/>
        <field name="act_window_id" ref="action_vifel_clients"/>
    </record>

    <record id="action_vifel_clients_tree" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="base.view_partner_tree"/>
        <field name="act_window_id" ref="action_vifel_clients"/>
    </record>

    <record id="action_vifel_clients_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form"/>
        <field name="act_window_id" ref="action_vifel_clients"/>
    </record>

    <!-- Sequence 0: first child of Inventory, so the app opens here -->
    <menuitem id="menu_vifel_clients"
              name="Clients"
              parent="stock.menu_stock_root"
              action="action_vifel_clients"
              sequence="0"/>

    <!--
        Creating a client from this screen should tag it Client, otherwise
        it vanishes from the list. The tag is a plain DB record with no XML
        id, so the default is wired by name on module update.
    -->
    <function model="ir.actions.act_window" name="vifel_set_client_tag_default"/>

</odoo>
