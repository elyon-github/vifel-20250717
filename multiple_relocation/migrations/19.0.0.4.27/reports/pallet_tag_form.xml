<t t-name="studio_report_document">
    <!-- Logo (Odoo 19): look up the attachment by name; falls back to the company logo, then to the original link -->
    <t t-set="logo_att" t-value="doc.env['ir.attachment'].sudo().search([('name', '=', 'viber_image_2025-05-07_14-50-45-872.png'), ('res_field', '=', False)], limit=1)"/>
    <t t-set="logo_src" t-value="(logo_att and image_data_uri(logo_att.datas)) or (doc.company_id.logo and image_data_uri(doc.company_id.logo)) or '/web/image/332-91a133d8/viber_image_2025-05-07_14-50-45-872.png'"/>
    <t t-foreach="doc.move_line_ids.sorted(lambda l: l.x_studio_pallet_series_id or '')" t-as="lines">
        <!-- Loop twice for each pallet series -->
        <t t-foreach="[1, 2]" t-as="copy_number">
            <div class="page" style="margin-bottom: 0; font-weight:bold">
                <table class="table table-bordered table-sm text-center" style="border: 1px solid black; margin-bottom: 0;">
                    <tbody>
                        <tr>
                            <td rowspan="2" class="align-middle" style="font-weight: bold;">
                                <img t-att-src="logo_src" alt="" class="img img-fluid o_we_custom_image" style="width: 180px"/>
                            </td>
                            <td style="width:80%; height: 20px; font-weight: bold;" colspan="3">
                                <span style="font-weight: bold;">Vifel Ice Plant and Cold Storage Inc.</span>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:80%; height: 20px; font-weight: bold;" colspan="3">
                                <span style="font-weight: bold;">Product Tag</span>
                            </td>
                        </tr>
                        <tr style="height: 120px; border-bottom: 1px solid white">
                            <td colspan="4" style="font-size: 8rem; line-height: 1.1; vertical-align: middle; font-weight:bold; white-space: nowrap">
                                <t t-if="lines.x_studio_pallet_series_id">
                                    <t t-esc="lines.x_studio_pallet_series_id"/>
                                    <t t-esc="lines.get_second_top_parent(lines.location_dest_id.complete_name)"/></t>
                                <t t-if="not lines.x_studio_pallet_series_id">
                                    N/A
                                </t>
                                <t t-if="lines.x_studio_return_count">
                                    <t t-esc="'-' + str(lines.x_studio_return_count)"/></t>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" style="font-size: 1.5rem; vertical-align: middle;  font-weight: bold;">
                                <t t-if="lines.result_package_id.name">
                                    Pallet#
                                </t>
                                <t t-esc="lines.result_package_id.name"/>
                            </td>
                        </tr>
                        <tr style="height: 32px;">
                            <td style="font-weight: bold;">
                                <h5 style="font-weight: bold; margin: 0;">Location</h5>
                            </td>
                            <td colspan="3" style="font-weight: bold;">
                                <h5 style="font-weight: bold; margin: 0;">
                                    <!--<t t-esc="lines.location_dest_id.complete_name"/>-->
                                </h5>
                            </td>
                        </tr>
                        <tr style="height: 32px;">
                            <td style="font-weight: bold;">
                                <h5 style="font-weight: bold; margin: 0;">Date</h5>
                            </td>
                            <td colspan="3" style="font-weight: bold;">
                                <h5 style="font-weight: bold; margin: 0;">
                                    <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/>
                                </h5>
                            </td>
                        </tr>
                        <tr style="height: 50px;">
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h3 style="font-weight: bold; margin: 0;">Client</h3>
                            </td>
                            <td style="vertical-align: middle; white-space: nowrap; font-weight: bold;" colspan="3">
                                <h4 style="font-weight: bold; margin: 0;">
                                    <t t-esc="lines.owner_id.name"/>
                                </h4>
                            </td>
                        </tr>
                        <tr style="height: 30px;">
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">Product Description:</h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;" colspan="3">
                                <!-- CHANGED: product description uses rem font size -->
                                <h4 style="font-weight: bold; white-space: nowrap; margin: 0; font-size: 1.8rem;">
                                    <t t-raw="lines.picking_id._wrap_text(lines.product_id.name or '', max_chars=45)"/>
                                </h4>
                            </td>
                        </tr>
                        <!-- CHANGED: Brand Name row made smaller (h4 to h6, shorter row) -->
                        <tr style="height: 30px;">
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">Brand Name:</h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;" colspan="3">
                                <t t-if="lines.product_id.product_template_variant_value_ids.name">
                                    <h6 style="font-weight: bold; margin: 0;">
                                        <t t-esc="lines.product_id.product_template_variant_value_ids.name"/>
                                    </h6>
                                </t>
                                <t t-else="">
                                    <h6 style="font-weight: bold; margin: 0;"/>
                                </t>
                            </td>
                        </tr>
                        <t t-if="lines.picking_id.show_batch_no">
                            <tr style="height: 50px;">
                                <td style="vertical-align: middle; font-weight: bold;">
                                    <h6 style="font-weight: bold; margin: 0;">Batch #:</h6>
                                </td>
                                <td style="vertical-align: middle; font-weight: bold;" colspan="3">
                                    <h6 style="font-weight: bold; margin: 0;">
                                        <t t-esc="lines.batch_no or ''"/>
                                    </h6>
                                </td>
                            </tr>
                        </t>
                        <t t-if="lines.picking_id._vifel_report_show_lot_no()">
                            <tr style="height: 50px;">
                                <td style="vertical-align: middle; font-weight: bold;">
                                    <h6 style="font-weight: bold; margin: 0;">Lot No.:</h6>
                                </td>
                                <td style="vertical-align: middle; font-weight: bold;" colspan="3">
                                    <h6 style="font-weight: bold; margin: 0;">
                                        <t t-esc="lines.picking_id._vifel_report_lot_no(lines) or ''"/>
                                    </h6>
                                </td>
                            </tr>
                        </t>
                        <tr style="height: 30px;">
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">Production Date:</h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">
                                    <t t-esc="lines.x_studio_production_date.strftime('%B %d, %Y') if lines.x_studio_production_date else ''"/>
                                </h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">Expiration Date:</h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">
                                    <!-- FIXED: condition now checks the expiration date field -->
                                    <t t-esc="lines.x_studio_expiration_date.strftime('%B %d, %Y') if lines.x_studio_expiration_date else ''"/>
                                </h6>
                            </td>
                        </tr>
                        <tr style="height: 30px;">
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">Quantity:</h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">
                                    <t t-esc="lines.x_studio_2nd_uom or ''"/>
                                    <t t-esc="lines.x_studio_quantity_uom.name"/>
                                </h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">Kilos:</h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">
                                    <t t-esc="lines.quantity or ''"/> KG
                                </h6>
                            </td>
                        </tr>
                        <!-- CHANGED: Checker's Name row made smaller (smaller font, shorter row) -->
                        <tr style="height: 30px;">
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; font-size: 0.85rem; margin: 0;">Checker's Name</h6>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;" colspan="3">
                                <h6 style="font-weight: bold; margin: 0;"/>
                            </td>
                        </tr>
                        <tr style="height: 30px;">
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">RR:</h6>
                            </td>
                            <!-- CHANGED: bigger font for RR number, kept on one line -->
                            <td style="vertical-align: middle; font-weight: bold; white-space: nowrap;">
                                <h4 style="font-weight: bold; margin: 0; font-size: 2rem;">
                                    <t t-esc="lines.picking_id.name"/>
                                </h4>
                            </td>
                            <td style="vertical-align: middle; font-weight: bold;">
                                <h6 style="font-weight: bold; margin: 0;">Container#:</h6>
                            </td>
                            <!-- CHANGED: bigger font for container number, kept on one line -->
                            <td style="vertical-align: middle; font-weight: bold; white-space: nowrap;">
                                <h4 style="font-weight: bold; margin: 0; font-size: 2rem;">
                                    <t t-esc="lines.x_studio_container_number"/>
                                </h4>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div style="margin-top: 4px;">
                <span>F-IMS-009</span>
            </div>
            <!-- Horizontal separator line between first and second copy -->
            <t t-if="copy_number_index == 0">
                <div style="border-top: 3px solid black; margin: 8px 0; width: 100%;"/>
            </t>
            <!-- Page break after second copy (but not after the very last item) -->
            <t t-if="copy_number_index == 1 and not lines_last">
                <p style="page-break-before:always;"/>
            </t>
        </t>
    </t>
</t>