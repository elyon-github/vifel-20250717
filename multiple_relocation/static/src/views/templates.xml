<templates xml:space="preserve">
    <!-- Balanced totals display with gradient -->
    <t t-name="web.ListView.Selection" t-inherit="web.ListView.Selection" t-inherit-mode="extension">
        <xpath expr="//a[@class='o_list_unselect_all btn btn-link py-0']" position="before">
                <!-- <t t-set-slot="layout-actions">
                    <SearchBar t-if="searchBarToggler.state.showSearchBar" autofocus="firstLoad"/>
                </t> -->
            <div t-if="nbSelected > 0" class="ms-3 d-flex align-items-center" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); padding: 5px 10px; border-radius: 6px; border-left: 3px solid #0d6efd; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                <div class="d-flex align-items-center gap-3">
                    <!-- No. of Pallets -->
                    <div class="text-center" t-if="isDomainSelected">
                        <div style="font-size: 10px; color: #6c757d; font-weight: 500; text-transform: uppercase;">No. of Pallets</div>
                        <div class="fw-bold" style="color: #0d6efd; font-size: 14px;" t-esc="selectedPalletsCount"/>
                    </div>
                    
                    <!-- QTY -->
                    <div class="text-center">
                        <div style="font-size: 10px; color: #6c757d; font-weight: 500; text-transform: uppercase;">Quantity</div>
                        <div class="fw-bold" style="color: #198754; font-size: 14px;" t-esc="selectedQuantitySum"/>
                    </div>
                    
                    <!-- KG -->
                    <div class="text-center">
                        <div style="font-size: 10px; color: #6c757d; font-weight: 500; text-transform: uppercase;">Weight (KG)</div>
                        <div class="fw-bold" style="color: #fd7e14; font-size: 14px;" t-esc="selectedKgSum"/>
                    </div>
                    
                    <!-- PACKS -->
                    <div class="text-center">
                        <div style="font-size: 10px; color: #6c757d; font-weight: 500; text-transform: uppercase;">Packs</div>
                        <div class="fw-bold" style="color: #dc3545; font-size: 14px;" t-esc="selectedPacksSum"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

    
</templates>