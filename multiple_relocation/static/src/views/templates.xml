<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- Option 1: Target the unselect button and add before it -->
    <t t-name="web.ListView.Selection" t-inherit="web.ListView.Selection" t-inherit-mode="extension">
        <xpath expr="//a[@class='o_list_unselect_all btn btn-link py-0']" position="before">
            <span t-if="nbSelected > 0" class="ms-3 badge bg-success text-white px-2 py-1 rounded-pill">
                <i class="oi oi-balance-scale me-1"></i>
                Total Qty: <span t-esc="SelectedQuantitySum"/>
            </span>
        </xpath>
    </t>
    
