<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Sort toggle beside "New" on the Clients kanban. Placed in the same
        control-panel slot the Generate Report button uses on the quant list,
        so the two custom buttons sit consistently top-left.
    -->
    <t t-name="multiple_relocation.VifelClientKanbanView" t-inherit="web.KanbanView">
        <xpath expr="//Layout/t[@t-set-slot='control-panel-create-button']" position="inside">
            <button type="button" class="btn btn-secondary ms-2"
                    t-on-click="onVifelSortToggle"
                    t-attf-title="Sorted by {{ vifelSortLabel }} — click to switch">
                <i class="fa fa-sort-amount-desc me-1"/>
                <t t-esc="vifelSortLabel"/>
            </button>
        </xpath>
    </t>
</templates>
