<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Line Search View -->
    <record id="view_fast_encode_rr_line_list" model="ir.ui.view">
        <field name="name">stock.move.line.fast_encode_rr.line.list</field>
        <field name="model">stock.move.line.fast_encode_rr.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="false" js_class="fast_encode_rr_list_button" multi_edit="1" class="no-footer">
                <field name="has_duplicate_pallet" column_invisible="1"/>
                <field name="transfer_id" column_invisible="1"/>
                <field name="product_id"/>
                <field name="pallet_series_id" column_invisible="context.get('is_blast_freeze')" force_save="1"/>
                <field name="result_package_id" string="RR Pallet #" groups="stock.group_tracking_lot" 
                    domain="[('location_id', '=', False), ('package_type_id.name', '=', 'Pallet'), '|', ('x_studio_receiving_report_id', '=', False),
                    ('x_studio_receiving_report_id', '=', transfer_id)]" 
                    options="{'no_create': True}" column_invisible="context.get('is_blast_freeze')" force_save="1"  decoration-danger="has_duplicate_pallet"/>
                <field name="bf_pallet_char" string="BFRR Pallet #" column_invisible="not context.get('is_blast_freeze')"/>
                <field name="location_dest_id" string="Location" column_invisible="context.get('is_blast_freeze')" readonly="1" force_save="1"/>
                <field name="container_number" string="Container #"/>
                <field name="production_date" string="Prod. Date"/>
                <field name="expiration_date" string="Exp. Date"/>
                <field name="quantity"/>
                <field name="quantity_uom" string="Qty UOM" options="{'no_create': True, 'no_open': True}" domain="[('category_id', 'ilike', 'Packaging UOM')]"/>
                <field name="kilogram" sum="Total"/>
                <field name="min_uom_unit"/>
                <field name="packs_uom" string="Packs UOM" options="{'no_create': True, 'no_open': True}" domain="[('category_id', 'ilike', 'min uom')]"/>
                <field name="original_pallet_series_id" column_invisible="1"/>
                <field name="original_location_dest_id" column_invisible="1"/>
                <field name="original_container_number" column_invisible="1"/>
                <field name="original_production_date" column_invisible="1"/>
                <field name="original_expiration_date" column_invisible="1"/>
                <field name="original_quantity_uom" column_invisible="1"/>
                <field name="original_packs_uom" column_invisible="1"/>

            </tree>
        </field>
    </record>

    <!-- Wizard Form View -->
    <record id="view_fast_encode_rr_wizard_form" model="ir.ui.view">
        <field name="name">stock.move.line.fast_encode_rr.form</field>
        <field name="model">stock.move.line.fast_encode_rr</field>
        <field name="arch" type="xml">
            <form string="Fast Encode RR">
                <sheet style="width: 100%; max-width: none; height: 800px;">
                    <div>
                        <field name="line_ids" nolabel="1" mode="tree,kanban">
                            <tree editable="bottom" limit="80">
                                <field name="product_id"/>
                                <field name="pallet_series_id"/>
                                <field name="bf_pallet_char"/>
                                <field name="quantity" sum="Total"/>
                                <field name="kilogram" sum="Total"/>
                                <field name="min_uom_unit" sum="Total"/>
                            </tree>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_fast_encode_rr_wizard" model="ir.actions.act_window">
        <field name="name">Fast Encode RR</field>
        <field name="res_model">stock.move.line.fast_encode_rr</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>