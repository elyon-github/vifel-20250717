<odoo>
    <record id="view_wizard_partial_package_notice_form" model="ir.ui.view">
        <field name="name">wizard.partial.package.notice.form</field>
        <field name="model">wizard.partial.package.notice</field>
        <field name="arch" type="xml">
            <form string="Incomplete Package Selection">
                <sheet style="width: 100%; max-width: none;">
                    <!-- Optional title or heading -->
                    <div class="oe_title">
                        <h2>Incomplete Package Selection</h2>
                    </div>

                    <!-- Alert box to draw attention -->
                    <div class="alert alert-warning" role="alert">
                        <strong>Detected unselected quants with the same pallet.</strong>
                        <br/>
                        Click <em>“Proceed Anyway”</em> to automatically add pallets with the already selected quants.
                    </div>

                    <group>
                        <field name="picking_id" readonly="1"/>
                    </group>

                        <!-- 
                            Display quants in a tree view instead of many2many tags.
                            Reference your custom tree view via 'tree_view_ref'.
                        -->
                        <field name="quant_ids"
                               mode="tree"
                               nolabel="1"/>

                    <!-- Footer buttons -->
                    <footer>
                        <button string="Proceed Anyway"
                                type="object"
                                name="action_proceed_with_missing_quants"
                                class="btn-primary"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
