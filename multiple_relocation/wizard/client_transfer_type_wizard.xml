<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_client_transfer_type_wizard_form" model="ir.ui.view">
        <field name="name">client.transfer.type.wizard.form</field>
        <field name="model">multiple_relocation.client.transfer.type.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Transfer Type" class="o_vifel_type_picker">
                <field name="partner_id" invisible="1"/>
                <field name="is_blast_freeze" invisible="1"/>
                <field name="incoming_label" invisible="1"/>
                <field name="outgoing_label" invisible="1"/>
                <field name="incoming_icon" invisible="1"/>
                <field name="outgoing_icon" invisible="1"/>

                <div class="o_vifel_picker_body">
                    <p class="o_vifel_picker_hint">
                        Choose which transfers to open — Draft, Waiting and
                        Ready are shown first.
                    </p>
                    <div class="o_vifel_picker_options">
                        <div class="o_vifel_picker_choice">
                            <button name="action_open_incoming" type="object"
                                    class="o_vifel_picker_card o_vifel_in">
                                <i class="fa fa-sign-in o_vifel_picker_icon" role="img"/>
                                <span class="o_vifel_picker_count">
                                    <field name="incoming_count" nolabel="1" readonly="1"/>
                                </span>
                                <span class="o_vifel_picker_label">
                                    <field name="incoming_label" nolabel="1" readonly="1"/>
                                </span>
                            </button>
                            <!-- Encoding starts from paper: the client and the
                                 direction are already known, so offer the new
                                 document here instead of via the list. -->
                            <button name="action_new_incoming" type="object"
                                    class="o_vifel_picker_new">
                                <i class="fa fa-plus me-1" role="img"/>New
                            </button>
                        </div>
                        <div class="o_vifel_picker_choice">
                            <button name="action_open_outgoing" type="object"
                                    class="o_vifel_picker_card o_vifel_out">
                                <i class="fa fa-sign-out o_vifel_picker_icon" role="img"/>
                                <span class="o_vifel_picker_count">
                                    <field name="outgoing_count" nolabel="1" readonly="1"/>
                                </span>
                                <span class="o_vifel_picker_label">
                                    <field name="outgoing_label" nolabel="1" readonly="1"/>
                                </span>
                            </button>
                            <button name="action_new_outgoing" type="object"
                                    class="o_vifel_picker_new">
                                <i class="fa fa-plus me-1" role="img"/>New
                            </button>
                        </div>
                    </div>
                </div>

                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
