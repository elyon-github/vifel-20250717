<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_quant_tree_custom" model="ir.ui.view">
        <field name="name">stock.quant.tree.custom</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id"/>
                <field name="owner_id"/>
                <field name="location_id"/>
                <field name="x_studio_pallet_series_id"/>
                <field name="package_id" string="Pallet #"/>
                <field name="x_studio_container_number"/>
                <field name="x_studio_production_date"/>
                <field name="x_studio_expiration_date"/>
                <field name="x_studio_expiration_date"/>
                <field name="x_studio_2nd_uom" sum="True" string="Quantity"/>
                <field name="x_studio_total_units"  sum="True" string="Minimum"/>
                <field name="quantity"  sum="True" string="Weight (KG)"/>
                <field name="reserved_quantity" sum="True"/>
                <field name="available_quantity" sum="True"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_stock_quant_search_custom" model="ir.ui.view">
        <field name="name">stock.quant.search.custom</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_studio_pallet_series_id"/>
                <field name="package_id"/>
                <field name="x_studio_container_number"/>
                <field name="product_id"/>
                <field name="owner_id"/>
                <field name="location_id"/>

                <filter name="filter_pallet_series" string="Pallet Series" domain="[('x_studio_pallet_series_id', '!=', False)]"/>
                <filter name="filter_container" string="Container Number" domain="[('x_studio_container_number', '!=', False)]"/>
            </search>
        </field>
    </record>

<record id="select_quant_wizard" model="ir.ui.view">
    <field name="name">select_quant.wizard.form</field>
    <field name="model">select_quant.wizard</field>
    <field name="arch" type="xml">
        <form string="Select Pallet Stocks">
            <group>
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="demand" readonly="1" string="Demand (KG)"/>

                </group>
                <group>

                    <field name="owner_id" readonly="1"/>
                    <field name="location_id" readonly="1"/>
                </group>
            </group>
            <div class="alert alert-success" role="success" >
                <strong>Note:</strong> Please use the <strong>Confirm Button</strong>  when modifying the Picked Quants Tab else use the <strong>Save Button</strong>  when modifying the Move Lines Tab. Thank you!
            </div>
            <div class="alert alert-danger" role="alert" 
                 invisible="not stock_moves_multiple_withdraw">
                    <strong>Adjustments: </strong> Please adjust the <strong>Quantity</strong> and <strong>Minimum</strong> Column in the Move Lines Tab with their actual Counted Quantity in proportion to the Actual Weight (KG) to be withdrawn.
                
            </div>

                
            <notebook>
                <page string="Picked Quants">
                    <field name="quant_ids_picked" 
                        domain="[('product_id', '=', product_id),
                                ('owner_id', '=', owner_id),
                                ('location_id', 'child_of', location_id),
                                ('location_id.usage', '=', 'internal'),
                                ('quantity', '>', 0),
                                ('on_hand', '=', True),
                                ]"
                        context="{'tree_view_ref': 'multiple_relocation.view_stock_quant_tree_custom',
                                 'search_view_ref': 'multiple_relocation.view_stock_quant_search_custom'}"
                    >
                        <tree>
                            <field name="product_id"/>
                            <field name="owner_id"/>
                            <field name="location_id"/>
                            <field name="x_studio_pallet_series_id"/>
                            <field name="bf_pallet_char" string="Pallet Text"/>
                            <field name="package_id" string="Pallet #"/>
                            <field name="x_studio_container_number"/>
                            <field name="x_studio_production_date"/>
                            <field name="x_studio_expiration_date"/>
                            <field name="quantity" sum="True" string="Weight (KG)"/>
                            <field name="reserved_quantity" sum="True" string="Reserved KG"/>
                            <field name="available_quantity" sum="True" string= "Available KG"/>
                        </tree>
                    </field>
                </page>
                    <page string="Move Lines">
                        <field name="move_line_ids"  domain="[('id', '=', 0)]">
                            <tree editable="bottom"   decoration-danger="is_package_multiple_withdraw"> 
                                <field name="x_studio_exp_warned" column_invisible="1" invisible="1" />
                                <field name="is_package_multiple_withdraw" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="location_dest_id" column_invisible="1"/>
                                <field name="product_id"/>
                                <field name="x_studio_return_count" readonly="1"/>
                                <field name="x_studio_special_holding" readonly="1"/>
                                <field name="x_studio_sh_reason" readonly="1"/>
                                <field name="x_studio_pallet_series_id" readonly="1"/>
                                <field name="package_id"  string="Pallet #" readonly="1"/>
                                <field name="reserved_quantity_on_validation"  string="Remaining Pallet Quantity" readonly="1" column_invisible="1"/>
                                <field name="location_id" readonly="1"/>
                                <field name="x_studio_container_number" readonly="1"/>
                                <field name="x_studio_production_date" readonly="1" />
                                <field name="x_studio_expiration_date" readonly="1" decoration-danger="x_studio_exp_warned"/>
                                <field name="x_studio_max_2nd_uom" string="Original Quantity" readonly="1"/>   
                                <field name="x_studio_affected_2nd_uom" string="Quantity" decoration-bg-info="is_package_multiple_withdraw" class="fw-bolder"/>
                                <field name="x_studio_actual_packaging" decoration-warning="1"/>
                                <field name="x_studio_quantity_uom_delivery" readonly="1"/>
                                <field name="x_studio_max_total_units" string="Original Minimum" readonly="1"/> 
                                <field name="x_studio_withdraw_units" string="Minimum" decoration-bg-info="is_package_multiple_withdraw" class="fw-bolder"/>
                                <field name="x_studio_actual_min" decoration-warning="1"/>
                                <field name="x_studio_min_quantity_uom" readonly="1"/>
                                <field name="x_studio_max_quant" string="Original Weight (KG)"/>   
                                <field name="quantity" string="Weight (KG)" decoration-bg-info="is_package_multiple_withdraw" class="fw-bolder"/>
                                <field name="x_studio_actual_kg" string="Actual Weight (KG)" decoration-warning="1"/>   

                                <!-- <field name="state"/> -->
                            </tree>
                        </field>
                    </page>

            </notebook>
                <div style="display: flex; justify-content: center; margin: 10px; gap: 10px;">
                    <button string="Get All Remaining Values From Multiple Withdrawal Pallets" 
                           type="object" 
                           name="auto_adjust_line_values" 
                           class="btn-success" 
                           data-hotkey="a" 
                           help="Get available quantity values from selected withdrawal pallets"
                           invisible="not stock_moves_multiple_withdraw"/>
                    <!-- <button string="Reset 3 UOM Values For Multiple Withdrawal" 
                           type="object" 
                           name="reset_values_for_multiple" 
                           class="btn-warning" 
                           data-hotkey="a" 
                           help="Reset UOM Values in order to give way for other transfers be able to select and pick the multiple withdrawal Packages"
                           invisible="not stock_moves_multiple_withdraw"/> -->
                </div>



            <div class="alert alert-danger" role="alert" 
                 invisible="not stock_moves_multiple_withdraw">
                <strong>Attention:</strong> A pallet appears in multiple active transfers. 
                Please review the <strong>Same Pallet Picked</strong> Table to confirm whether this duplication 
                is intentional. If this is unexpected, investigate potential inventory 
                conflicts before proceeding. (This happens because a single Pallet was selected for <strong>Multiple Withdrawal/Multiple Transfer Record </strong>)
            </div>

        <notebook>
                 <page string="Same Pallet Picked" invisible="not stock_moves_multiple_withdraw">
                        <field name="stock_moves_multiple_withdraw"  domain="[('id', '=', 0)]" readonly="1">
                            <tree decoration-danger="1">
                               <field name="company_id" column_invisible="1"/>
                                <field name="create_uid" optional="show" widget="many2one_avatar_user"/>
                                <field name="picking_id" widget="many2onebutton"/>
                                <field name="product_id" readonly="1"/>
                                <field name="package_id"  string="Pallet #" readonly="1"/>
                                <field name="location_id" readonly="1"/>
                                <field name="x_studio_container_number" readonly="1"/>
                                <field name="x_studio_production_date" readonly="1"/>
                                <field name="x_studio_expiration_date" readonly="1"/>
                                <field name="x_studio_max_2nd_uom" string="Original Quantity" readonly="1"/>   
                                <field name="x_studio_affected_2nd_uom" string="Quantity" decoration-bg-info="1"/>
                                <field name="x_studio_quantity_uom_delivery"/>
                                <field name="x_studio_max_total_units" string="Original Minimum" readonly="1"/> 
                                <field name="x_studio_withdraw_units" string="Minimum" decoration-bg-info="1"/>
                                <field name="x_studio_min_quantity_uom"/>
                                <field name="x_studio_max_quant" string="Original WEIGHT"/> 
                                <field name="quantity" string="WEIGHT (KG)" decoration-bg-info="1"/>   
  
                            </tree>
                        </field>
                    </page>
        </notebook>
            <footer>
                <button string="Confirm" type="object" name="action_confirm" class="btn-primary" data-hotkey="c"/>
                <button string="Save" special="save" class="btn-primary" data-hotkey="s"/>
                <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="j"/>
            </footer>
        </form>
    </field>
</record>


</odoo>
