<!-- views/stock_quant_correction_wizard.xml -->

<odoo>
    <data>
        
        <!-- Wizard Form View -->
<record id="view_stock_quant_correction_wizard" model="ir.ui.view">
    <field name="name">stock.quant.correction.wizard.form</field>
    <field name="model">stock.quant.correction.wizard</field>
    <field name="arch" type="xml">
        <form string="Stock Quant Corrections" class="o_form_view o_form_wizard">
            <sheet style="width: 100%; max-width: none;">

                <!-- Warning Banner -->
                <div class="alert alert-danger" role="alert" style="margin-bottom: 20px;">
                    <i class="fa fa-exclamation-triangle"/> 
                    <strong>Note:</strong> This wizard allows adjustments to <strong>Pallet details</strong>.
                    Please double-check your entries before confirming to ensure accuracy.
                </div>

                <!-- Reason for Adjustment -->
                <!-- <group> -->
                    <field name="reason_for_adjustment" 
                           placeholder="Explain the reason for these pallet corrections..." 
                           nolabel="1" 
                           widget="text"
                           required="1"/>
                    
                    <!-- Skip Approval Toggle (Only for Managers) -->
                    <field name="skip_approval" 
                           widget="boolean_toggle"
                           invisible="not reason_for_adjustment or 1"
                           string="Apply Immediately (Skip Approval)"
                           help="If checked, changes will be applied immediately without approval. Only available for Inventory Suprvisor."/>
                <!-- </group> -->
                
                <!-- Info Messages -->
                <div class="alert alert-info" invisible="skip_approval or not reason_for_adjustment" role="alert" style="margin-top: 15px;">
                    <i class="fa fa-info-circle"/> 
                    This will create an adjustment request for approval. Changes will not be applied until approved by an inventory supervisor.
                </div>
                <div class="alert alert-warning" invisible="not skip_approval" role="alert" style="margin-top: 15px;">
                    <i class="fa fa-exclamation-triangle"/> 
                    Changes will be applied immediately without approval workflow.
                </div>

                <!-- Adjustment Lines -->
                <field name="line_ids" nolabel="1" invisible="not reason_for_adjustment" style="margin-top: 20px;">
                    <tree editable="bottom" create="false" delete="false">
                        <!-- Hidden fields -->
                        <field name="quant_id" column_invisible="1"/>
                        <field name="lot_id" column_invisible="1"/>
                        <field name="x_studio_pallet_series_id" column_invisible="1"/>
                        
                        <!-- Visible fields -->
                        
                        <field name="owner_id" optional="show" force_save="1" readonly="1"/>
                        <field name="product_id" required="1"/>
                        <field name="display_pallet_series_id" string="Pallet Series" readonly="1"/>
                        <field name="package_id" 
                               string="Pallet #" 
                               domain="[('location_id', '=', False), ('x_studio_receiving_report_id', '=', False), ('package_type_id.name', '=', 'Pallet')]"/>
                        <field name="x_studio_2nd_uom" string="Quantity"/>
                        <field name="x_studio_quantity_uom" 
                               string="Quantity UOM" 
                               domain="[('category_id', 'ilike', 'Packaging UOM')]" 
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="x_studio_total_units" string="Packs"/>
                        <field name="x_studio_min_quantity_uom" 
                               string="Packs UOM" 
                               domain="[('category_id', 'ilike', 'min')]" 
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="quantity" string="Weight (KG)"/>
                        <field name="x_studio_return_count" string="Return Count" optional="hide"/>
                    </tree>
                </field>

            </sheet>
        
            <footer>
                <button name="action_confirm_corrections" 
                        string="Confirm Corrections"
                        type="object" 
                        class="btn-primary" 
                        confirm="Are you sure you want to confirm these changes?"/>
                <button string="Cancel" 
                        class="btn-secondary" 
                        special="cancel"/>
            </footer>
        </form>
    </field>
</record>
        <!-- Action for the wizard -->
        <record id="action_stock_quant_correction_wizard" model="ir.actions.act_window">
            <field name="name">Adjust Pallet Details</field>
            <field name="res_model">stock.quant.correction.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_active_ids': active_ids}</field>
        </record>
        
        <!-- Inherit stock.quant list view to add header button -->
        <record id="stock_quant_tree_view_inherit" model="ir.ui.view">
            <field name="name">stock.quant.tree.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="inside">
                    <header>
                        <button name="action_stock_quant_relocate" 
                                string="Relocate Pallets" 
                                type="object" 
                                groups="__custom__.inventory_analyst,__custom__.inventory_supervisor,multiple_relocation.inventory_super_admin" 
                                invisible="context.get('hide_location', False)" 
                                context="{'action_ref': 'stock.action_view_quants'}" 
                                class="btn-primary"/>
                        <button name="%(action_stock_quant_correction_wizard)d" 
                                string="Adjust Pallet Details" 
                                type="action" 
                                groups="__custom__.inventory_analyst,__custom__.inventory_supervisor,multiple_relocation.inventory_super_admin"
                                class="btn-primary"/>
                    </header>
                </xpath>
            </field>
        </record>
                
        <!-- Add action to stock.quant list view (alternative method) -->
        <record id="action_stock_quant_correction" model="ir.actions.server">
            <field name="name">Correct Quants</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="binding_model_id" ref="stock.model_stock_quant"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = {
        'name': 'Adjust Pallet Details',
        'type': 'ir.actions.act_window',
        'res_model': 'stock.quant.correction.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {'active_ids': records.ids, 'active_model': 'stock.quant'}
    }
else:
    raise UserError("Please select at least one stock quant to correct.")
            </field>
        </record>



        <record id="view_stock_quant_adjustment_request_tree" model="ir.ui.view">
            <field name="name">stock.quant.adjustment.request.tree</field>
            <field name="model">stock.quant.adjustment.request</field>
            <field name="arch" type="xml">
                <tree string="Adjustment Requests" 
                      decoration-info="state == 'draft'" 
                      decoration-warning="state == 'pending'"
                      decoration-success="state == 'approved'"
                      decoration-danger="state == 'rejected'"
                      decoration-muted="state == 'cancelled'" create="0" delete="0">
                    
                    <field name="name" string="Request #"/>
                    <field name="requested_by" widget="many2one_avatar_user"/>
                    <field name="requested_date" widget="date"/>
                    <field name="reason_for_adjustment"/>
                    <field name="line_count" string="Total Lines"/>
                    <field name="pending_line_count" string="Pending" 
                           decoration-warning="pending_line_count > 0"/>
                    <field name="approved_line_count" string="Approved" 
                           decoration-success="approved_line_count > 0"/>
                    <field name="rejected_line_count" string="Rejected" 
                           decoration-danger="rejected_line_count > 0"/>
                    <field name="conflict_count" string="Conflicts" 
                           decoration-danger="conflict_count > 0"
                           optional="show"/>
                    <field name="state" widget="badge" 
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'pending'"
                           decoration-success="state == 'approved'"
                           decoration-danger="state == 'rejected'"
                           decoration-muted="state == 'cancelled'"/>
                    <field name="approved_by" optional="hide"/>
                    <field name="batch_number" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- ==================== FORM VIEW ==================== -->
        <record id="view_stock_quant_adjustment_request_form" model="ir.ui.view">
            <field name="name">stock.quant.adjustment.request.form</field>
            <field name="model">stock.quant.adjustment.request</field>
            <field name="arch" type="xml">
                <form string="Adjustment Request">
                    <header>
                        <!-- Submit for Approval (Draft → Pending) -->
                        <button name="action_submit_for_approval" 
                                string="Submit for Approval" 
                                type="object" 
                                class="oe_highlight"
                                invisible="state != 'draft'"
                                confirm="Submit this request for approval?"/>
                        
                        <!-- Select/Deselect Actions -->
                        <!-- <button name="action_select_all_pending" 
                                string="Select All Pending" 
                                type="object" 
                                class="btn-secondary"
                                invisible="state not in ['pending', 'partial']"
                                groups="stock.group_stock_manager"/>
                        
                        <button name="action_deselect_all" 
                                string="Deselect All" 
                                type="object" 
                                class="btn-secondary"
                                invisible="state not in ['pending', 'partial'] or selected_line_count == 0"
                                groups="stock.group_stock_manager"/> -->
                        
                        <!-- Approve/Reject Selected -->
                        <button name="action_approve_selected" 
                                string="Approve Selected" 
                                type="object" 
                                class="btn-success"
                                invisible="state not in ['pending', 'partial'] or selected_line_count == 0"
                                groups="__custom__.inventory_supervisor, multiple_relocation.inventory_super_admin"
                                confirm="Approve selected lines?"/>
                        
                        <button name="action_reject_selected" 
                                string="Reject Selected" 
                                type="object" 
                                class="btn-danger"
                                invisible="state not in ['pending', 'partial'] or selected_line_count == 0"
                                groups="__custom__.inventory_supervisor, multiple_relocation.inventory_super_admin"/>
                        
                        <!-- Approve All Pending Lines -->
                        <button name="action_approve_all_pending" 
                                string="Approve All Pending" 
                                type="object" 
                                class="oe_highlight"
                                invisible="state not in ['pending', 'partial'] or pending_line_count == 0"
                                groups="__custom__.inventory_supervisor, multiple_relocation.inventory_super_admin"/>
                                confirm="Approve all pending lines without conflicts?"/>
                        
                        <!-- Check for Conflicts -->
                        <button name="action_check_conflicts" 
                                string="Check Conflicts" 
                                type="object" 
                                class="btn-secondary"
                                groups="multiple_relocation.inventory_super_admin"/>
                                invisible="state not in ['pending', 'partial']"/>
                        
                        <!-- Cancel Request -->
                        <button name="action_cancel" 
                                string="Cancel Request" 
                                type="object" 
                                invisible="state not in ['draft', 'pending', 'partial']"
                                confirm="Cancel this adjustment request?"/>
                        
                        <!-- Reset to Draft -->
                        <button name="action_set_to_draft" 
                                string="Reset to Draft" 
                                type="object" 
                                invisible="state != 'cancelled'"/>
                        
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,pending,approved"/>
                    </header>
        
                    <sheet>
                        <!-- Alert Banners -->
                        <field name="has_conflicts" invisible="1"/>
                        <div class="alert alert-warning" role="alert" 
                             invisible="not has_conflicts or state not in ['pending', 'partial']">
                            <i class="fa fa-exclamation-triangle"/> 
                            <strong>Warning:</strong> <field name="conflict_count"/> line(s) have conflicts. 
                            Click "Check Conflicts" to refresh status.
                        </div>
        
                        <div class="alert alert-info" role="alert" 
                             invisible="state != 'draft'">
                            <i class="fa fa-info-circle"/> 
                            <strong>Draft:</strong> Review the lines below and click "Submit for Approval" when ready.
                        </div>
        
                        <div class="alert alert-success" role="alert" 
                             invisible="state != 'approved'">
                            <i class="fa fa-check-circle"/> 
                            <strong>Approved:</strong> All lines have been approved and applied. 
                            Batch #: <field name="batch_number" readonly="1" class="fw-bold"/>
                        </div>
                        
                        <!-- Selection Info Banner -->
                        <div class="alert alert-info" role="alert" 
                             invisible="selected_line_count == 0">
                            <i class="fa fa-check-square-o"/> 
                            <strong><field name="selected_line_count"/> line(s) selected</strong> - 
                            Use "Approve Selected" or "Reject Selected" buttons above.
                        </div>
        
                        <!-- Header Information -->
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="requested_by" widget="many2one_avatar_user" readonly="1"/>
                                <field name="requested_date" readonly="1"/>
                                <field name="reason_for_adjustment" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="line_count" readonly="1"/>
                                <field name="pending_line_count" readonly="1" 
                                       decoration-warning="pending_line_count > 0"/>
                                <field name="approved_line_count" readonly="1" 
                                       decoration-success="approved_line_count > 0"/>
                                <field name="rejected_line_count" readonly="1" 
                                       decoration-danger="rejected_line_count > 0"/>
                                <field name="selected_line_count" readonly="1"
                                       decoration-info="selected_line_count > 0"/>
                                <field name="approved_by" readonly="1" 
                                       invisible="not approved_by"/>
                                <field name="approved_date" readonly="1" 
                                       invisible="not approved_date"/>
                                <field name="batch_number" readonly="1" 
                                       invisible="not batch_number"/>
                            </group>
                        </group>
        
                        <!-- Line Items -->
                        <notebook>
                            <page string="Adjustment Lines" name="lines">
                                <field name="line_ids" nolabel="1">
                                    <tree string="Lines" 
                                          decoration-success="line_state == 'approved'"
                                          decoration-danger="line_state == 'rejected' or conflict_status != 'ok'"
                                          decoration-warning="line_state == 'pending' and conflict_status == 'ok'"
                                          decoration-muted="line_state == 'cancelled'"
                                          create="false"
                                          delete="false">
                                        
                                        <!-- Selection Checkbox -->
                                        <field name="selected" 
                                               widget="boolean_toggle"
                                               readonly="line_state != 'pending'"/>
                                        
                                        <!-- Pallet Info -->
                                        <field name="display_pallet_series" string="Pallet Series"/>
                                        <field name="display_location" string="Location" optional="hide"/>
                                        
                                        <!-- CHANGED: Show dynamic changes instead of all old/new fields -->
                                        <field name="changed_fields_display" string="Changes" widget="html"/>
                                        
                                        <!-- Status -->
                                        <field name="conflict_status" string="Conflict" 
                                               widget="badge"
                                               decoration-success="conflict_status == 'ok'"
                                               decoration-danger="conflict_status in ['changed', 'reserved', 'deleted']"/>
                                        <field name="line_state" string="Status" 
                                               widget="badge"
                                               decoration-info="line_state == 'draft'"
                                               decoration-warning="line_state == 'pending'"
                                               decoration-success="line_state == 'approved'"
                                               decoration-danger="line_state == 'rejected'"
                                               decoration-muted="line_state == 'cancelled'"/>
                                        
                                        <!-- Approval Info -->
                                        <field name="approved_by" optional="hide" 
                                               invisible="not approved_by"/>
                                        <field name="approved_date" optional="hide" 
                                               invisible="not approved_date"/>
                                        <field name="rejection_reason" optional="hide" 
                                               invisible="not rejection_reason"/>
                            
                                        <button name="action_view_line_details" 
                                                string="View Details" 
                                                type="object" 
                                                icon="fa-eye"
                                                class="btn-link"/>
                                        
                                        <!-- Hidden fields for domain/logic -->
                                        <field name="quant_id" column_invisible="1"/>
                                        <field name="request_id" column_invisible="1"/>
                                        <field name="has_changes" column_invisible="1"/>
                                    </tree>
                                </field>
                            </page>
        
                            <!-- Optional: Show only conflicts -->
                            <page string="Conflicts" name="conflicts" 
                                  invisible="not has_conflicts">
                                <field name="line_ids" nolabel="1" 
                                       domain="[('conflict_status', '!=', 'ok')]">
                                    <tree string="Conflicted Lines" 
                                          decoration-danger="1"
                                          create="false" 
                                          edit="false" 
                                          delete="false">
                                        
                                        <!-- Selection Checkbox (but readonly for conflicts) -->
                                        <!-- <field name="selected" 
                                               widget="boolean_toggle"
                                               readonly="1"/> -->
                                        
                                        <!-- Pallet Info -->
                                        <field name="display_pallet_series" string="Pallet Series"/>
                                        <field name="display_location" string="Location" optional="hide"/>
                                        
                                        <!-- Show Changes using the same HTML field -->
                                        <field name="changed_fields_display" string="Changes" widget="html"/>
                                        
                                        <!-- Status -->
                                        <field name="conflict_status" string="Conflict" 
                                               widget="badge"
                                               decoration-success="conflict_status == 'ok'"
                                               decoration-danger="conflict_status in ['changed', 'reserved', 'deleted']"/>
                                        <field name="line_state" string="Status" 
                                               widget="badge"
                                               decoration-info="line_state == 'draft'"
                                               decoration-warning="line_state == 'pending'"
                                               decoration-success="line_state == 'approved'"
                                               decoration-danger="line_state == 'rejected'"
                                               decoration-muted="line_state == 'cancelled'"/>
                                        
                                        <!-- Approval Info -->
                                        <field name="approved_by" optional="hide" 
                                               invisible="not approved_by"/>
                                        <field name="approved_date" optional="hide" 
                                               invisible="not approved_date"/>
                                        <field name="rejection_reason" optional="hide" 
                                               invisible="not rejection_reason"/>
                            
                                        <button name="action_view_line_details" 
                                                string="View Details" 
                                                type="object" 
                                                icon="fa-eye"
                                                class="btn-link"/>
                                        
                                        <!-- Hidden fields for domain/logic -->
                                        <field name="quant_id" column_invisible="1"/>
                                        <field name="request_id" column_invisible="1"/>
                                        <field name="has_changes" column_invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
        
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <!-- ==================== LINE FORM VIEW (Optional - for details) ==================== -->
        <record id="view_stock_quant_adjustment_line_form" model="ir.ui.view">
            <field name="name">stock.quant.adjustment.line.form</field>
            <field name="model">stock.quant.adjustment.line</field>
            <field name="arch" type="xml">
                <form string="Adjustment Line Details" create="false" delete="false">
                    <header>
                        <field name="line_state" widget="statusbar" 
                               statusbar_visible="draft,pending,approved"/>
                        <field name="conflict_status" invisible="1"/>
                    </header>
                    <sheet style="width: 100%; max-width: none;">
                        <div class="alert alert-danger" role="alert" 
                             invisible="conflict_status == 'ok'">
                            <i class="fa fa-exclamation-triangle"/> 
                            <strong>Conflict:</strong> <field name="conflict_status" readonly="1"/> 
                            - This line cannot be approved until the conflict is resolved.
                        </div>

                        <group>
                            <group string="Pallet Information">
                                <field name="quant_id" readonly="1" groups="multiple_relocation.inventory_super_admin"/>
                                <field name="display_pallet_series" readonly="1"/>
                                <field name="display_location" readonly="1"/>
                            </group>
                            <group string="Status">
                                <field name="has_changes" readonly="1"/>
                                <field name="approved_by" readonly="1" invisible="not approved_by"/>
                                <field name="approved_date" readonly="1" invisible="not approved_date"/>
                                <field name="rejection_reason" readonly="1" invisible="not rejection_reason"/>
                            </group>
                        </group>

                        <notebook>
                                <page string="Changes" name="changes">
                                    <field name="changed_fields_display" nolabel="1" widget="html"/>
                                </page>
                            <page string="Snapshot" name="snapshot" groups="multiple_relocation.inventory_super_admin">
                                <field name="quant_snapshot" readonly="1" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        
        <!-- ==================== REJECTION WIZARD FORM VIEW ==================== -->
        <record id="view_stock_quant_adjustment_reject_wizard_form" model="ir.ui.view">
            <field name="name">stock.quant.reject.wizard.form</field>
            <field name="model">stock.quant.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Adjustment Lines">
                    <sheet style="width: 100%; max-width: none;">
                        <!-- Warning Banner -->
                        <div class="alert alert-warning" role="alert" style="margin-bottom: 20px;">
                            <i class="fa fa-exclamation-triangle"/> 
                            <strong>Warning:</strong> You are about to reject <field name="line_count" readonly="1" class="fw-bold"/> adjustment line(s). Please provide a clear reason for rejection.
                        </div>
        
                        <!-- Hidden Fields -->
                        <group invisible="1">
                            <field name="request_id"/>
                        </group>
        
                        <!-- Lines to be Rejected with Changes -->
                        <field name="line_ids" nolabel="1" readonly="1" mode="tree">
                            <tree decoration-warning="1" create="false" delete="false" edit="false">
                                <field name="display_pallet_series" string="Pallet Series"/>
                                <field name="display_location" string="Location" optional="hide"/>
                                <field name="changed_fields_display" string="Changes" widget="html"/>
                                <field name="line_state" widget="badge"/>
                            </tree>
                        </field>
        
                        <!-- Rejection Reason -->
                        <field name="rejection_reason" 
                               placeholder="Explain why these adjustments are being rejected..."
                               nolabel="1"
                               widget="text"
                               required="1"
                               style="margin-top: 20px;"
                               options="{'placeholder': 'Explain why these adjustments are being rejected...'}"/>
                    </sheet>
        
                    <footer>
                        <button name="action_confirm_reject" 
                                string="Confirm Rejection" 
                                type="object" 
                                class="btn-danger"
                                confirm="Are you sure you want to reject these adjustment lines?"/>
                        <button string="Cancel" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <!-- ==================== ACTIONS ==================== -->
        <record id="action_stock_quant_adjustment_request" model="ir.actions.act_window">
            <field name="name">Pallet Detail Adjustment Requests</field>
            <field name="res_model">stock.quant.adjustment.request</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No adjustment requests yet
                </p>
                <p>
                    Adjustment requests are created when users make changes to pallet details
                    that require approval before being applied.
                </p>
            </field>
        </record>

        <!-- ==================== MENU ITEMS ==================== -->
        <menuitem id="menu_stock_quant_adjustment_request"
                  name="Pallet Detail Adjustment Requests"
                  parent="stock.menu_warehouse_report"
                  action="action_stock_quant_adjustment_request"
                  sequence="10"
                  groups="stock.group_stock_manager,stock.group_stock_user"/>
    </data>
</odoo>