<!-- views/stock_quant_correction_wizard.xml -->

<odoo>
    <data>
        
        <!-- Wizard Form View -->
        <record id="view_stock_quant_correction_wizard" model="ir.ui.view">
            <field name="name">stock.quant.correction.wizard.form</field>
            <field name="model">stock.quant.correction.wizard</field>
            <field name="arch" type="xml">
             <form string="Stock Quant Corrections" class="o_form_view o_form_wizard">
                <sheet style="width: 100%; max-width: none;">

                <!-- ✅ Friendly red banner -->
                <div class="alert alert-danger" role="alert" style="margin-bottom: 10px;">
                    <strong>Note:</strong> This wizard allows adjustments to <code>Pallet details</code>.
                    Please double-check your entries before confirming to ensure accuracy.
                </div>

                <group style="margin-top: 50px; margin-bottom: 50px;">
                    <field name="reason_for_adjustment" placeholder="Explain the reason for these pallet corrections..." nolabel="0" 
                           widget="textarea"/>
                </group>
                    <div style="width: 100%; margin-top: 10px;">
                        <field name="line_ids" nolabel="1" invisible="not reason_for_adjustment">
                            <tree editable="bottom" create="false" delete="false">
                                <!-- Read-only reference fields -->
                                <field name="quant_id" column_invisible="1"/>
                                <field name="lot_id" column_invisible="1"/>
                                <field name="owner_id" />
                                <!-- Editable fields -->
                                <field name="product_id" required="1"/>
                                <field name="x_studio_return_count" />
                                <field name="x_studio_pallet_series_id" optional="hide"/>
                                <field name="display_pallet_series_id" readonly="1"/>
                                <field name="package_id" string="Pallet #" domain="[('location_id', '=', False), ('x_studio_receiving_report_id', '=', False), ('package_type_id.name', '=', 'Pallet')]"/>
                                <field name="x_studio_2nd_uom" string="Quantity"/>
                                <field name="x_studio_quantity_uom" string="Quantity UOM" domain="[('category_id', 'ilike', 'Packaging UOM')]" options="{'no_create': True, 'no_open': True}"/>
                                <field name="x_studio_total_units" string="Packs"/>
                                <field name="x_studio_min_quantity_uom" string="Packs UOM" domain="[('category_id', 'ilike', 'min')]" options="{'no_create': True, 'no_open': True}"/>
                                <field name="quantity" string="Weight (KG)"/>
                                <!-- <field name="x_studio_building_dropped"/> -->
                                <!-- <field name="x_studio_container_number"/> -->
                                <!-- <field name="x_studio_production_date"/>
                                <field name="x_studio_expiration_date"/> -->
                                <!-- <field name="x_studio_loading_dock_no"/> -->
                                <!-- <field name="x_studio_source"/> -->
                                <!-- <field name="x_studio_truck_number"/> -->
                                <!-- <field name="x_studio_gate_pass"/> -->
                                <!-- <field name="x_studio_truck_time"/>
                                <field name="x_studio_start_time"/>
                                <field name="x_studio_end_time"/> -->
                            </tree>
                        </field>
                    </div>

                    
                </sheet>
            
                <footer>
                    <button name="action_confirm_corrections" string="Confirm Corrections"
                            type="object" class="btn-primary" confirm="Are you absolutely sure you wanted to confirm the changes made?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
            </field>
        </record>
        
        <!-- Action for the wizard -->
        <record id="action_stock_quant_correction_wizard" model="ir.actions.act_window">
            <field name="name">Adjust Pallet Details</field>
            <field name="res_model">stock.quant.correction.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_active_ids': active_ids}</field>
        </record>
        
        <!-- Inherit stock.quant list view to add header button -->
        <record id="stock_quant_tree_view_inherit" model="ir.ui.view">
            <field name="name">stock.quant.tree.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="inside">
                    <header>
                        <button name="action_stock_quant_relocate" string="Relocate" type="object" groups="stock.group_stock_manager" invisible="context.get('hide_location', False)" context="{'action_ref': 'stock.action_view_quants'}" class="btn-primary"/>
                        <button name="%(action_stock_quant_correction_wizard)d" 
                                string="Adjust Pallet Details" 
                                type="action" 
                                class="btn-primary"/>
                    </header>
                </xpath>
            </field>
        </record>
        
        <!-- Add action to stock.quant list view (alternative method) -->
        <record id="action_stock_quant_correction" model="ir.actions.server">
            <field name="name">Correct Quants</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="binding_model_id" ref="stock.model_stock_quant"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = {
        'name': 'Adjust Pallet Details',
        'type': 'ir.actions.act_window',
        'res_model': 'stock.quant.correction.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {'active_ids': records.ids, 'active_model': 'stock.quant'}
    }
else:
    raise UserError("Please select at least one stock quant to correct.")
            </field>
        </record>
        
    </data>
</odoo>