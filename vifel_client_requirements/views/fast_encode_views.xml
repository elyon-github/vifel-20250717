<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Magic Wizard: merge columns, the Merge / Un-merge entry, and the
         exclusion of pallets already merged onto.

         Injected here so core's FastEncodeRR view carries no trace of the
         feature. -->
    <record id="view_fast_encode_rr_line_list_merge" model="ir.ui.view">
        <field name="name">stock.move.line.fast_encode_rr.line.list.merge</field>
        <field name="model">stock.move.line.fast_encode_rr.line</field>
        <field name="inherit_id"
               ref="multiple_relocation.view_fast_encode_rr_line_list"/>
        <field name="arch" type="xml">

            <field name="wizard_id" position="after">
                <field name="is_pallet_merge" column_invisible="1"/>
                <field name="vifel_merge_locked_package_ids" column_invisible="1"/>
                <field name="show_merge_button" column_invisible="1"/>
            </field>

            <!-- NO readonly= on pallet_series_id: the field is already
                 readonly at the Python level, and a view-level modifier
                 OVERRIDES that default — setting readonly="is_pallet_merge"
                 silently made PSI editable on every NON-merged row. Only the
                 tint marks merged rows. -->
            <field name="pallet_series_id" position="attributes">
                <attribute name="decoration-info">is_pallet_merge</attribute>
            </field>

            <!-- A merged row is locked to its adopted pallet, and a pallet
                 another line already merged onto is not selectable at all:
                 it is reached through the Merge button, which sets flag,
                 series and location together. -->
            <field name="result_package_id" position="attributes">
                <attribute name="readonly">is_pallet_merge</attribute>
                <attribute name="domain">[('location_id', '=', False), ('package_type_id.name', '=', 'Pallet'),
                             ('x_studio_active', '=', True),
                             ('x_studio_warehouse', '=', warehouse_id),
                             ('id', 'not in', vifel_merge_locked_package_ids),
                             '|', ('x_studio_receiving_report_id', '=', False),
                             ('x_studio_receiving_report_id', '=', transfer_id)]</attribute>
            </field>

            <field name="location_dest_id" position="after">
                <button name="action_merge_from_fast_encode" type="object"
                        string="Merge" class="btn-link" icon="fa-object-group"
                        column_invisible="context.get('is_blast_freeze')"
                        invisible="not show_merge_button or is_pallet_merge"/>
                <button name="action_unmerge_from_fast_encode" type="object"
                        string="Un-merge" class="btn-link text-warning"
                        icon="fa-chain-broken"
                        column_invisible="context.get('is_blast_freeze')"
                        invisible="not show_merge_button or not is_pallet_merge"/>
            </field>

            <field name="container_number" position="after">
                <field name="client_lot_no" string="Lot No."
                       column_invisible="not context.get('show_client_lot_no')"/>
            </field>

        </field>
    </record>

</odoo>
