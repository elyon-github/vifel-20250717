<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VIFEL Configuration tab on the Contact form.

         Config is Elyon/Vifel-side: encoders never open this, they only ever
         see the resulting Merge Pallet button on their transfer lines. -->
    <record id="view_partner_form_vifel_config" model="ir.ui.view">
        <field name="name">res.partner.form.vifel.config</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <!-- Shown for contacts tagged Client (category 1), OR for any
                     contact that already carries VIFEL settings. The second
                     clause is the escape hatch: hard-coding the tag id means a
                     contact tagged differently would otherwise be permanently
                     unconfigurable, with the tab silently absent and no clue
                     why. Anything already configured stays reachable. -->
                <page string="VIFEL Configuration" name="vifel_configuration"
                      invisible="not set(category_id).intersection([1])
                                 and not vifel_can_merge_pallets
                                 and not vifel_show_lot_no
                                 and not vifel_show_batch_no">
                    <!-- Step 1: does this client merge at all? Everything
                         else stays hidden until it does, so a client that
                         does not merge shows exactly one checkbox. -->
                    <group>
                        <group string="Pallet Merging">
                            <field name="vifel_can_merge_pallets"/>
                        </group>
                        <group string="Documents">
                            <field name="vifel_show_lot_no"/>
                            <field name="vifel_show_batch_no"/>
                        </group>
                    </group>

                    <!-- Step 2: which of the two ways does it merge? -->
                    <group string="How this client merges"
                           invisible="not vifel_can_merge_pallets">
                        <field name="vifel_multiple_pallet_support"/>
                        <div class="oe_grey" colspan="2"
                             invisible="vifel_multiple_pallet_support">
                            Off — every merge is offered the same one pallet,
                            named below.
                        </div>
                        <div class="oe_grey" colspan="2"
                             invisible="not vifel_multiple_pallet_support">
                            On — merges are offered the client's special
                            pallets, listed below.
                        </div>

                        <!-- Fixed: one pinned pallet, forever -->
                        <!-- Only a pallet that is free, or already holds THIS
                             client's stock. Pinning a pallet occupied by
                             someone else would offer every merge a target
                             holding another client's goods. -->
                        <field name="vifel_fixed_package_id"
                               invisible="vifel_multiple_pallet_support"
                               domain="['|', ('quant_ids', '=', False),
                                        ('quant_ids.owner_id', '=', id)]"
                               options="{'no_create': True}"/>
                        <field name="vifel_fixed_psi"
                               invisible="vifel_multiple_pallet_support"/>

                        <!-- Multiple: widen the candidates -->
                        <field name="vifel_include_regular_pallets"
                               invisible="not vifel_multiple_pallet_support"/>
                    </group>

                    <!-- Step 3: the pallet types themselves. Deliberately NOT
                         called "condition pallets": three of the four seeded
                         types are damage grades, but BOC is the client's own
                         static pallet, which is not a condition at all.
                         The Next Series column shows the real next number, so
                         the table explains its format without a paragraph. -->
                    <group string="Pallet Types"
                           invisible="not vifel_can_merge_pallets
                                      or not vifel_multiple_pallet_support">
                        <field name="vifel_psi_type_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="prefix"/>
                                <field name="next_number"/>
                                <field name="next_series_preview" readonly="1"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
