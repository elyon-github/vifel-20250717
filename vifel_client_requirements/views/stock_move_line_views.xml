<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pallet Breakdown: merge columns and the Merge / Un-merge entry.

         All of this used to be spread across multiple_relocation's own views;
         it lives here so core carries no trace of the feature. This view
         inherits the SAME base view core does, and loads after it, so the
         anchors below (vifel_dest_location_name, location_dest_id) are the
         ones core has already placed. -->
    <record id="view_move_line_detailed_op_merge_button" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.op.merge.button</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id"
               ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">

            <!-- Selection-bar button: tick several lines, merge them all onto
                 one pallet in a single pass.
                 APPEND to the EXISTING header (the Pallet Breakdown already
                 has one, carrying Verify Transfer / Assign Pallet Series /
                 Spawn Magic Wizard / … from multiple_relocation). Creating a
                 SECOND <header> makes the list render only one and silently
                 drops the other's buttons — never do that. -->
            <xpath expr="//tree/header" position="inside">
                <button name="action_open_pallet_merge_wizard_multi"
                        type="object" string="Merge Selected"
                        class="btn-primary" icon="fa-object-group"
                        invisible="context.get('picking_code') != 'incoming' or context.get('state') == 'done'"/>
            </xpath>

            <field name="vifel_dest_location_name" position="after">
                <!-- Client Lot No. — only for clients whose profile shows it.
                     The context flag is supplied by action_detailed_operations
                     in this module; without it the column stays hidden. -->
                <field name="client_lot_no" string="Lot No." optional="show"
                       column_invisible="not context.get('show_client_lot_no')"
                       readonly="state == 'done'"/>
                <!-- Merged-pallet marker: this line joined an already stocked
                     pallet and is NOT counted as a received pallet. -->
                <field name="is_pallet_merge" string="Merged" optional="show"
                       readonly="1"
                       column_invisible="picking_code == 'outgoing'"/>
                <field name="vifel_show_merge_button" column_invisible="1"/>
                <button name="action_open_pallet_merge_wizard" type="object"
                        string="Merge Pallet" class="btn-link"
                        icon="fa-object-group"
                        invisible="not vifel_show_merge_button or is_pallet_merge"/>
                <button name="action_unmerge_pallet_line" type="object"
                        string="Un-merge" class="btn-link text-warning"
                        icon="fa-chain-broken"
                        invisible="not vifel_show_merge_button or not is_pallet_merge"/>
            </field>

            <!-- A merged line must stay where the pallet it joined is
                 standing. Un-merge first to move it. -->
            <xpath expr="//tree//field[@name='location_dest_id'][2]"
                   position="attributes">
                <attribute name="readonly">state == 'done' or is_pallet_merge</attribute>
            </xpath>

        </field>
    </record>

</odoo>
