<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Batch # on the picking form's Operations tab.

         The value is encoded per line in the Pallet Breakdown; this column is
         the roll-up (stock.move.batch_no_display) so the encoder can confirm it
         on the picking itself before printing the Pallet Tag Form, without
         opening the breakdown for every move. -->
    <record id="view_picking_form_batch_no" model="ir.ui.view">
        <field name="name">stock.picking.form.batch.no</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <!-- After multiple_relocation (priority 16), whose xpaths build the
             Operations tree this one anchors into. -->
        <field name="priority">30</field>
        <field name="arch" type="xml">

            <!-- column_invisible is evaluated with the PARENT record in scope,
                 so show_batch_no has to be on the form for parent.show_batch_no
                 to resolve — an absent field there silently kills the column. -->
            <xpath expr="//field[@name='picking_type_code']" position="after">
                <field name="show_batch_no" invisible="1"/>
            </xpath>

            <!-- Anchored on x_studio_kg_variance (multiple_relocation) so the
                 column lands at the end of the Weight (KG) group, matching the
                 Batch # position on the Pallet Tag. Incoming only: on a
                 withdrawal the batch has become the read-back Prodcode, which
                 the Pallet Breakdown shows in its own column. -->
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='operations']/field[@name='move_ids_without_package']/tree[1]/field[@name='x_studio_kg_variance']"
                   position="after">
                <field name="batch_no_display" string="Batch #" optional="show"
                       readonly="1"
                       column_invisible="not parent.show_batch_no or parent.picking_type_code == 'outgoing'"/>
            </xpath>

        </field>
    </record>

</odoo>
