<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_pkr_report_wizard_form" model="ir.ui.view">
        <field name="name">pallet_kilos_record_model.report.wizard.form</field>
        <field name="model">pallet_kilos_record_model.report.wizard</field>
        <field name="arch" type="xml">
<form string="Generate Report">
                <div class="alert alert-info text-center" role="alert">
                    <i class="fa fa-file-excel-o"/>
                    Select a <strong>report type</strong>, filter by client and date range, then click <strong>Generate</strong>.
                </div>
                <group>
                    <group string="Report">
                        <field name="report_type" widget="selection"/>
                    </group>
                </group>
                <field name="is_full_history_report" invisible="1"/>
                <group invisible="report_type == 'daily_pallet_utilization'">
                    <group string="Customer / Client">
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="All clients (leave empty for all)" string="Customers" colspan="2"/>
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="All warehouses (leave empty for all)" colspan="2"/>
                    </group>
                    <!-- The Inbound Log always covers all history: each row is a
                         pallet shown with its live balance, so filtering rows by
                         receiving date would hide stock that is still on hand. -->
                    <group string="Date Range" invisible="is_full_history_report">
                        <field name="date_from" placeholder="Leave empty for all history"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <div class="text-muted" invisible="not is_full_history_report">
                    <i class="fa fa-info-circle"/>
                    This report always covers <strong>all history</strong> and shows each pallet's
                    available balance <strong>as of now</strong>, so no date range applies.
                </div>
                <footer>
                    <button name="action_generate_report" string="Generate" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_pkr_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Report</field>
        <field name="res_model">pallet_kilos_record_model.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
