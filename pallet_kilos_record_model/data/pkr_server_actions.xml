<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Recompute Balances: rebuild running balances for the selected rows'
         partitions (balances-only, from stored operation totals). -->
    <record id="action_recompute_pkr_balances" model="ir.actions.server">
        <field name="name">Recompute Balances</field>
        <field name="model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_recompute_selected_balances()</field>
    </record>

    <!-- Re-sync Pallet Counts: rebuild pallets received/withdrawn from the
         documents and adjustment_pallets from recorded history; anchor any
         untraceable residual on the owner's latest row (remarked). -->
    <record id="action_resync_pallet_counts_pkr" model="ir.actions.server">
        <field name="name">Re-sync Pallet Counts</field>
        <field name="model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_resync_pallet_counts()</field>
    </record>

    <!-- Get Unsynced: read-only report of ledger-vs-physical-stock discrepancies
         per (owner, warehouse, BF) partition. Includes blast-freeze stock. -->
    <record id="action_get_unsynced_pkr" model="ir.actions.server">
        <field name="name">Get Unsynced</field>
        <field name="model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_get_unsynced()</field>
    </record>

    <!-- Past re-uploads: zeroing + re-upload done from Inventory > Apply
         before stock counts posted to the ledger (see stock_count.py).
         Preview lists them; Book posts them (admins only). -->
    <record id="action_preview_past_reuploads_pkr" model="ir.actions.server">
        <field name="name">Past Re-uploads: Preview</field>
        <field name="model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = model.action_preview_past_reuploads()</field>
    </record>

    <record id="action_book_past_reuploads_pkr" model="ir.actions.server">
        <field name="name">Past Re-uploads: Book</field>
        <field name="model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_model_id" ref="model_pallet_kilos_record_model_pallet_kilos_record_model"/>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_book_past_reuploads()</field>
    </record>

</odoo>
