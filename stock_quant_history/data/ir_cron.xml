<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Daily CRON: generate snapshot for yesterday + cleanup old ones -->
    <record id="ir_cron_daily_snapshot" model="ir.cron">
        <field name="name">Inventory Snapshot: Daily Generation + Cleanup</field>
        <field name="model_id" ref="model_stock_quant_history_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_daily_snapshot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 12:05 AM Manila = 16:05 UTC (previous day) -->
        <field name="nextcall" eval="'2026-03-12 16:05:00'"/>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
    </record>

    <!-- Backfill CRON: generate 5 snapshots per run every 20 mins,
         auto-deactivates when all 60 days are covered -->
    <record id="ir_cron_backfill_snapshots" model="ir.cron">
        <field name="name">Inventory Snapshot: Backfill (5 per run)</field>
        <field name="model_id" ref="model_stock_quant_history_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_backfill_snapshots()</field>
        <field name="interval_number">20</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="'2026-03-11 16:00:00'"/>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
    </record>

</odoo>
