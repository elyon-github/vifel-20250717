<odoo>

    <record model="ir.ui.view" id="view_stock_quant_history_search">
        <field name="name">stock.quant.history.search</field>
        <field name="model">stock.quant.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" />
                <field name="x_studio_pallet_series_id" string="Pallet Series ID"/>
                <field name="package_id" string="Pallet #"/>
                <field name="x_studio_container_number" string="Container #"/>
                <field
                    name="location_id"
                    string="Location and sub-locations of"
                    operator="child_of"
                />
                <field name="company_id" />
                <field name="lot_id" />
                <filter
                    string="Stock date"
                    name="inventory_date"
                    date="inventory_date"
                    default_period="this_month"
                />

                <group expand="0" string="Group By">
                    <filter
                        name="group_by_owner_id"
                        string="Owner"
                        context="{'group_by':'owner_id'}"
                    />
                    <filter
                        name="group_by_x_studio_container_number"
                        string="Container Number"
                        context="{'group_by':'x_studio_container_number'}"
                    />
                    <filter
                        name="group_by_package_id"
                        string="Pallet #"
                        context="{'group_by':'package_id'}"
                    />
                    <filter
                        name="group_by_snapshot_id"
                        string="Snapshot"
                        context="{'group_by':'snapshot_id'}"
                    />
                    <filter
                        name="group_by_date"
                        string="Inventory date"
                        context="{'group_by':'inventory_date'}"
                    />
                    <filter
                        name="group_by_product_id"
                        string="Product"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        name="group_by_lot_id"
                        string="Lot"
                        context="{'group_by':'lot_id'}"
                    />
                    <filter
                        name="group_by_location_id"
                        string="Location"
                        context="{'group_by':'location_id'}"
                    />
                    <filter
                        name="group_by_transaction_type"
                        string="Is Blast Freeze"
                        context="{'group_by':'is_a_blast_freeze'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="view_stock_quant_history_list">
        <field name="name">stock.quant.history.list</field>
        <field name="model">stock.quant.history</field>
        <field name="arch" type="xml">
            <tree>
                <field name="snapshot_id" optional="hide" />
                <field name="inventory_date" optional="show" />
                <field name="company_id" column_invisible="True"/>
                <field name="location_id" readonly="id" options="{'no_create': True}"/>
                <field name="is_a_blast_freeze" readonly="id" column_invisible="True"/>
                <field name="owner_id" readonly="id" options="{'no_create': True}"/>
                <field name="product_id" readonly="context.get('single_product', False) or id" force_save="1" options="{'no_create': True}" widget="many2one"/>
                <field name="x_studio_special_holding" readonly="id" string="Special Holding"/>
                <field name="x_studio_sh_reason" readonly="id" string="Special Holding Reason" optional="hide"/>
                <field name="x_studio_return_count" string="Return Count"/>
                <field name="package_id" groups="stock.group_tracking_lot" readonly="id" string="Pallet #"/>
                <field name="x_studio_pallet_series_id" groups="stock.group_tracking_lot" readonly="id" string="Pallet Series ID"/>
                <field name="x_studio_container_number" readonly="id" string="Container #"/>
                <field name="x_studio_production_date"  readonly="id"/>
                <field name="x_studio_expiration_date"  readonly="id"/>
                <field name="x_studio_source"  readonly="id" optional="hide"/>
                <field name="x_studio_gate_pass"  readonly="id" optional="hide"/>
                <!-- <field name="x_studio_truck_type"  readonly="id" optional="hide"/> -->
                <field name="x_studio_truck_time"  readonly="id" optional="hide"/>
                <field name="x_studio_start_time"  readonly="id" optional="hide"/>
                <field name="x_studio_end_time"  readonly="id" optional="hide"/>
                <field name="lot_id"  readonly="id" optional="hide"/>
                <field name="x_studio_2nd_uom" optional="show" sum="Total Quantity" string="Total Quantity"/>
                <field name="x_studio_quantity_uom" optional="show" string="Quantity Unit of Measure"/>
                <field name="x_studio_total_units" optional="show" sum="Total Min Units" string="Total Minimum"/>
                <field name="x_studio_min_quantity_uom" optional="show" string="Minimum Unit of Measure" />
                <field name="quantity" string="On Hand Weight(KG)" readonly="0" sum="Total On Hand"/>
                <!-- <field name="reserved_quantity" optional="show" sum="Total Reserved" string="Reserved Weight(KG)"/>
                <field name="available_quantity" optional="show" sum="Total Available" string="Available Weight(KG)"/> -->
                <field name="product_uom_id" string="Unit" groups="uom.group_uom"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_stock_quant_history_pivot">
        <field name="name">stock.quant.history.pivot</field>
        <field name="model">stock.quant.history</field>
        <field name="arch" type="xml">
            <pivot string="Stock quants" sample="1">
                <field name="product_id" type="row" />
                <field name="location_id" type="row" />
                <field name="snapshot_id" type="col" />
                <field name="quantity" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="action_stock_quant_history" model="ir.actions.act_window">
        <field name="name">Stock snapshot</field>
        <field name="res_model">stock.quant.history</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('owner_id','!=',False)]</field>
        <field name="search_view_id" ref="view_stock_quant_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_nocreate">
                Generate stock quant history from stock quant history snapshot before!
            </p>
        </field>
    </record>

    <menuitem
        id="menu_action_stock_quant_history"
        parent="menu_action_stock_history"
        name="Stock history"
        action="action_stock_quant_history"
        sequence="10"
    />

</odoo>
