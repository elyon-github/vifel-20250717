<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Location search view for the client "Locations" smart button: the
        standard filters plus Building (searchable and group-able), which is
        how the warehouse actually navigates its bins.
    -->
    <record id="view_location_search_vifel_building" model="ir.ui.view">
        <field name="name">stock.location.search.vifel.building</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_search"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <field name="warehouse_id" position="after">
                <field name="x_studio_building" string="Building"/>
            </field>
            <filter name="usage" position="after">
                <filter string="Building" name="groupby_building" domain="[]"
                        context="{'group_by': 'x_studio_building'}"/>
            </filter>
        </field>
    </record>

</odoo>
